{
  "name": "tako",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "tako": "node scripts/tako.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@tako/db",
    "db:migrate": "turbo run db:migrate --filter=@tako/db",
    "db:studio": "turbo run db:studio --filter=@tako/db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.1.0",
    "socket.io-client": "^4.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
