# Context di build = ROOT del monorepo (sia per apps/server/Dockerfile che per
# apps/server/deploy/Dockerfile.cloud). Escludiamo tutto ciò che non serve nell'immagine:
# dipendenze reinstallate dentro l'immagine, build artifact, segreti, dati locali.

# Dipendenze: reinstallate nell'immagine con pnpm --frozen-lockfile.
**/node_modules

# Git e metadati repo
.git
.gitignore
.gitattributes

# Segreti e ambiente locale — MAI dentro l'immagine (i secret arrivano da Fly).
**/.env
**/.env.*
!**/.env.example

# Build artifact / cache
**/dist
**/.next
**/.turbo
*.tsbuildinfo

# Dati locali appliance / store ~/.tako / Postgres portatile (mai nel cloud)
packages/db/.pgdata
**/uploads
.tako

# Tooling agenti / docs strategiche / artefatti macchina
.claude
.claude.bak
.superpowers
strategia-vendita
materiali
**/*.log
.DS_Store
Thumbs.db
