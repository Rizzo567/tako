# Tako — variabili di PRODUZIONE (copia in .env.production, NON committare i valori veri).
# Segreti veri solo nell'ambiente del provider / secret manager, mai nel repo.

# --- Postgres (servizio compose) ---
POSTGRES_USER=tako
POSTGRES_PASSWORD=__metti_una_password_forte__
POSTGRES_DB=takodb

# --- Connessione del server al DB ---
# In prod usa il ruolo NON-superuser tako_app per ATTIVARE la RLS (vedi RUNBOOK §RLS).
# Superuser (tako) = RLS bypassata; tako_app = RLS applicata.
DATABASE_URL=postgresql://tako_app:__password_tako_app__@postgres:5432/takodb

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth / sicurezza ---
JWT_SECRET=__stringa_lunga_casuale__   # firma sessioni + JWT tavolo + cookie

# --- AI ---
GROQ_API_KEY=__groq_key__              # insights + chat cliente (read-only fallback)
ANTHROPIC_API_KEY=                     # opzionale: assistente agentico Claude (lascia vuoto se non usato)
OPENAI_API_KEY=                        # opzionale

# --- URL pubblici (per CORS + cookie cross-dominio) ---
DASHBOARD_URL=https://dashboard.iltuodominio.it
CLIENT_BASE_URL=https://ordina.iltuodominio.it

# --- Upload ---
UPLOADS_DIR=/data/uploads
