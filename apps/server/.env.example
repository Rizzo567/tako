DATABASE_URL=postgresql://tako:tako@localhost:5432/takodb
JWT_SECRET=change-this-to-a-long-random-string
PORT=3001
CLIENT_BASE_URL=http://localhost:3002
UPLOADS_DIR=./uploads
OPENAI_API_KEY=sk-...
REDIS_URL=redis://localhost:6379

# ─── CLOUD CONTROL-PLANE (TAKO_MODE=cloud) — vedi .env.example di root per i dettagli ───
TAKO_MODE=local
CLOUD_DATABASE_URL=postgresql://user:pass@host.neon.tech/takocloud?sslmode=require
SESSION_SECRET=change-this-to-a-long-random-string
TOKEN_PEPPER=change-this-to-a-32-byte-hex-secret
ALLOWED_ORIGINS=https://app.tako.example,https://tako.example
SITE_BASE_URL=https://app.tako.example
COOKIE_MODE=samesite
EMAIL_FROM=Tako <no-reply@tako.example>
EMAIL_TRANSPORT=mock
TRUST_PROXY=1
# Fase 2b (placeholder, non usati in 2a)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BASE_URL=https://api.tako.example
RESEND_API_KEY=
