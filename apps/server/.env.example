DATABASE_URL=postgresql://tako:tako@localhost:5432/takodb
JWT_SECRET=change-this-to-a-long-random-string
PORT=3001
CLIENT_BASE_URL=http://localhost:3002
UPLOADS_DIR=./uploads
OPENAI_API_KEY=sk-...
REDIS_URL=redis://localhost:6379

# ─── APPLIANCE ↔ CLOUD (modo local) — pairing identità owner ───
# URL del control-plane per pairing/heartbeat (es. https://api.tako.app). Vuoto = pairing
# disabilitato (appliance in local puro). Vedi .env.example di root per i dettagli.
CLOUD_BASE_URL=

# ─── CLOUD CONTROL-PLANE (TAKO_MODE=cloud) — vedi .env.example di root per i dettagli ───
TAKO_MODE=local
CLOUD_DATABASE_URL=postgresql://user:pass@host.neon.tech/takocloud?sslmode=require
SESSION_SECRET=change-this-to-a-long-random-string
TOKEN_PEPPER=change-this-to-a-32-byte-hex-secret
ALLOWED_ORIGINS=https://app.tako.example,https://tako.example
SITE_BASE_URL=https://app.tako.example
COOKIE_MODE=samesite
EMAIL_FROM=Tako <no-reply@tako.example>
# 'mock' (default, console) | 'resend' (reale: richiede RESEND_API_KEY)
EMAIL_TRANSPORT=mock
RESEND_API_KEY=
TRUST_PROXY=1
# ─── OAuth (ogni provider si attiva solo se id+secret presenti) ───
# Redirect URI Google:  <OAUTH_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL GitHub:  <OAUTH_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BASE_URL=https://api.tako.example

# ── Foto AI piatti (Nano Banana Pro / Google Gemini) — opzionale ──
# Attiva la generazione della foto piatto stilizzata. Serve una API key Gemini
# (Google AI Studio). Poi attiva il toggle "Foto AI piatti" in Impostazioni → Funzionalità.
# GEMINI_API_KEY=la-tua-chiave
# Modello immagini: default gemini-2.5-flash-image ("Nano Banana"); per la variante Pro
# imposta l'id del modello pro rilasciato da Google.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
