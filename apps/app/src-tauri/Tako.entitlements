<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Consente l'input audio (microfono) quando l'app gira con hardened runtime.
       Coppia obbligata con NSMicrophoneUsageDescription nell'Info.plist. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
