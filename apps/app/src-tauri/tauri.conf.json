{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tako",
  "version": "0.1.0",
  "identifier": "com.tako.dashboard",
  "build": {
    "frontendDist": "../standalone-dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 10, "y": 18 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/server/**/*", "resources/web/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
