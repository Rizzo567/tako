# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to git. It is already in .gitignore.

# ─── REQUIRED — server will refuse to start without these ─────────────────────

# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=

# PostgreSQL connection string (update credentials from defaults in production)
DATABASE_URL=postgresql://tako:tako@localhost:5432/takodb

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Frontend origins (for CORS and Socket.io)
DASHBOARD_URL=http://localhost:3000
CLIENT_BASE_URL=http://localhost:3002

# Redis (used for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# OpenAI API key (only required if AI chat feature is enabled)
OPENAI_API_KEY=

# File upload directory (absolute path recommended in production)
UPLOADS_DIR=./uploads

# Server port
PORT=3001

# ─── APPLIANCE ↔ CLOUD (modo local) — pairing identità owner ──────────────────
# URL pubblico del control-plane Tako verso cui questa appliance fa pairing/heartbeat
# (es. https://api.tako.app). Se ASSENTE, il pairing cloud è disabilitato e l'appliance
# resta in modo local puro (login owner/staff/PIN locali, nessuna identità sincronizzata).
# Conta solo in TAKO_MODE=local. Distinto da OAUTH_BASE_URL/SITE_BASE_URL (lato cloud).
CLOUD_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUD CONTROL-PLANE (TAKO_MODE=cloud) — identità owner centralizzata
# ───────────────────────────────────────────────────────────────────────────────
# Queste variabili contano SOLO quando TAKO_MODE=cloud. In modo local (default) sono
# ignorate. Il control-plane è un deploy SEPARATO dall'appliance: non condivide DB
# né segreti con l'installazione locale.

# Attiva il modo: 'local' (default, appliance) | 'cloud' (control-plane identità).
TAKO_MODE=local

# Connessione al DB CLOUD (Neon EU). DEVE essere DIVERSA da DATABASE_URL: non puntare
# mai al Postgres locale. Obbligatoria in TAKO_MODE=cloud.
CLOUD_DATABASE_URL=postgresql://user:pass@host.neon.tech/takocloud?sslmode=require

# Segreto per firmare i cookie cloud (anti-tamper). Distinto da JWT_SECRET.
# Genera: openssl rand -hex 64 . Obbligatorio (≥32 char in produzione) in modo cloud.
SESSION_SECRET=

# Pepper per HMAC dei token a riposo (verifica email, reset, sessioni). Genera:
# openssl rand -hex 32 . Obbligatorio (≥16 char) in modo cloud. Mai committare il valore reale.
TOKEN_PEPPER=

# Allowlist ESATTA delle origin del front-end cloud (CORS), separate da virgola.
# Nessuna wildcard, nessun suffix-match.
ALLOWED_ORIGINS=https://app.tako.example,https://tako.example

# Base URL pubblica del sito cloud: usata per costruire i link nelle email
# (verifica/reset) e come allowlist dei redirect. Mai derivata dall'header Host.
SITE_BASE_URL=https://app.tako.example

# Modalità cookie: 'samesite' (default, SameSite=Lax — front-end e API same-site)
# | 'crosssite' (SameSite=None;Secure + CSRF double-submit header X-Tako-CSRF).
COOKIE_MODE=samesite

# Mittente delle email transazionali. Con EMAIL_TRANSPORT=resend deve essere un mittente
# verificato sul dominio Resend (SPF+DKIM+DMARC). Formato: "Tako <no-reply@tako.app>".
EMAIL_FROM=Tako <no-reply@tako.example>

# Transport email: 'mock' (default, logga su console — dev/test) | 'resend' (invio reale
# via API Resend). Con 'resend' RESEND_API_KEY è obbligatoria (fail-fast all'avvio).
EMAIL_TRANSPORT=mock

# API key del provider email Resend. Obbligatoria solo con EMAIL_TRANSPORT=resend.
# Letta SOLO da env, mai nel codice. Mai committare il valore reale.
RESEND_API_KEY=

# Hop di proxy fidati davanti al control-plane (per derivare req.ip dall'X-Forwarded-For).
# '1' = un solo proxy (default). Non usare 'true' senza un proxy che riscrive l'header.
TRUST_PROXY=1

# ─── Cloud — OAuth Google / GitHub ──────────────────────────────────────────────
# Login social per gli owner. Ogni provider si attiva SOLO se id+secret sono presenti
# (altrimenti la rispettiva route /api/auth/<provider> non viene montata).
#
# Google Cloud Console → OAuth consent + Client ID/Secret.
#   Authorized redirect URI = <OAUTH_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub → Developer settings → OAuth App.
#   Authorization callback URL = <OAUTH_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Base URL pubblica su cui rientrano i callback OAuth (es. https://api.tako.app).
# I redirect_uri si costruiscono SOLO da qui (env fissa), mai dall'header Host.
OAUTH_BASE_URL=https://api.tako.example
